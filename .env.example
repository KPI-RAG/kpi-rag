# ==============================================================================
# KPI-RAG Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit your actual .env file containing private keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider (Google Gemini)
# ------------------------------------------------------------------------------
# Default backend in configs/config.yaml for explanation generation (Track C)
# and interactive explanation generation in the Streamlit dashboard.
# Get a key (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Secondary / Evaluation LLM Provider (Groq)
# ------------------------------------------------------------------------------
# Required for running Track B G-Eval judge scripts (scripts/run_eval_track_b.py)
# and integration test suite tests (tests/integration/test_08_full_rag_cycle_real.py).
# Get a key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 3. Optional / Benchmark Evaluation Providers
# ------------------------------------------------------------------------------
# Optional: Alternative OpenAI-compatible backend used by evaluation scripts
# such as scripts/run_eval_track_d.py when evaluating TeleQnA benchmarks.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Hugging Face User Access Token (read) for dataset downloading
# if fetching raw benchmarks/models from Hugging Face Hub.
# Get a token: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
